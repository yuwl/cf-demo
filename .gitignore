dist/
build/

# Cloudflare
.wrangler/
.dev.vars
.dev.vars.*
# 但示例文件要进仓库 —— 上面的 .dev.vars.* 会把它一起匹配掉，
# 少了这行，新克隆下来的仓库里就没有 .dev.vars.example，README 里的 cp 会失败
!.dev.vars.example

# 环境变量（只提交 .env.example）
.env
.env.local
.env.*.local

