# 复制为 .dev.vars 后填入真实值（.dev.vars 已在 .gitignore 中，不会被提交）
#
# 生成 JWT_SECRET：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=请替换为32字节随机hex

# ---- 本地开发覆盖项 ----
# wrangler.jsonc 里的 vars 是「生产」取值（指向 cf-demo-web.pages.dev）。
# 本地 wrangler dev 时用下面两行把它改回本地，否则注册后的验证邮件
# 会把链接指到线上 Pages 域名上去。
APP_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# ---- 注册口令（可选兜底）----
# 注册口令的**主存**是 D1 的 app_settings 表（键 register_code），不是这里。
# 放数据库是为了：不进公开仓库 + 自己随时能查（wrangler secret 写进去就读不出来了）。
# 本文件里这一行只是「数据库读不到时的兜底」，一般不填。
#
# 写入 / 查看 / 更换口令：
#   npx wrangler d1 execute cf-demo-db --local  --command "select value from app_settings where key='register_code'"
#   npx wrangler d1 execute cf-demo-db --remote --command "select value from app_settings where key='register_code'"
#
# 三层优先级：app_settings.register_code > REGISTER_CODE 环境变量 > 不设限（注册完全开放）
REGISTER_CODE=

# Resend 邮件服务（https://resend.com/api-keys）
# 不填也能跑：验证邮件会降级为打印到 wrangler dev 的控制台
RESEND_API_KEY=

# ---- R2 预签名直传（可选）----
# 不填也能跑：头像上传会降级为经由 Worker 中转写入 R2
# R2 的 S3 API 凭据需要在 Cloudflare 控制台 R2 → Manage R2 API Tokens 单独创建
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
